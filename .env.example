# İçeriklerin duracağı klasör (zims/, maps/, kolibri/ alt klasörleri oluşturulur)
# Where content is stored (zims/, maps/, kolibri/ subfolders are created)
DATA_DIR=./data

# Web arayüzünün portu / web port  ->  http://<host>:HTTP_PORT/home
HTTP_PORT=80

# Konteynerlerin çalışacağı kullanıcı (DATA_DIR'e yazabilmeli) / container user (must own DATA_DIR)
PUID=1000
PGID=1000

TZ=Europe/Istanbul
KIWIX_VERSION=3.8.2

# Boş bırakılırsa en yeni Protomaps derlemesi kullanılır (örn. 20261102)
# Empty = newest Protomaps planet build (e.g. 20261102)
PROTOMAPS_BUILD=
